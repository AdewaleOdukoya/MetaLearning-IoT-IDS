cat > .gitignore << 'EOF'
# Data
data/raw/
data/processed/

# Experiment outputs
experiments/
src/experiments/*.pyc

# Reports (keep the code that generates them, not the generated artifacts)
reports/figures/*.png
reports/tables/*.csv

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Environment
.env
venv/
*.egg-info/

# OS
.DS_Store

# Model checkpoints
*.pt
*.pth

# Editor
.vscode/
EOF